# Azure AD / Entra ID
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-server-app-client-id
AZURE_CLIENT_SECRET=your-server-app-client-secret

# CosmosDB
COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/
COSMOS_KEY=your-cosmos-key
COSMOS_DATABASE=study-guild

# Server
PORT=3001
NODE_ENV=development

# Client (Vite exposes VITE_ prefixed vars)
# Put these in client/.env.local
# VITE_AZURE_CLIENT_ID=your-spa-client-id
# VITE_AZURE_TENANT_ID=your-tenant-id
# VITE_API_BASE_URL=http://localhost:3001
